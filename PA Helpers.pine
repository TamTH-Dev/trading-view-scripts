//@version=6

indicator(title = "PA Helpers", overlay = true)

//-----------------------------------------------------------------------------
// Constants
//-----------------------------------------------------------------------------

// Colors
color TRANSPARENT_COLOR = #ffffff00
color WHITE_COLOR       = #dee2e6
color BLACK_COLOR       = #000000
color RED_COLOR         = #F72585
color ORANGE_COLOR      = #fb5607
color YELLOW_COLOR      = #ffbe0b
color GREEN_COLOR       = #2a9d8f
color AQUA_COLOR        = #4CC9F0
color BLUE_COLOR        = #4361ee
color PURPLE_COLOR      = #3F37C9
color PINK_COLOR        = #B5179E
color VIOLET_COLOR      = #9242ed
color LIGHT_GRAY_COLOR  = #364156
color DARK_GRAY_COLOR   = #212d40
color TEXT_COLOR        = #ced4da

//-----------------------------------------------------------------------------
// EMAs
//-----------------------------------------------------------------------------

// Settings
//-----------------------------------------------------------------------------

string emaGroup = "EMAs"

string ema1Inline = "EMA 1"
bool ema1Show = input.bool(true, "EMA 1", inline = ema1Inline, group = emaGroup)
string ema1Timeframe = input.timeframe("", title = "", inline = ema1Inline, group = emaGroup)
int ema1Length = input.int(20, minval = 1, title = "", inline = ema1Inline, group = emaGroup)
color ema1Color = input.color(color.new(AQUA_COLOR, 35), title = "", inline = ema1Inline, group = emaGroup)

string ema2Inline = "EMA 2"
bool ema2Show = input.bool(true, "EMA 2", inline = ema2Inline, group = emaGroup)
string ema2Timeframe = input.timeframe("", title = "", inline = ema2Inline, group = emaGroup)
int ema2Length = input.int(50, minval = 1, title = "", inline = ema2Inline, group = emaGroup)
color ema2Color = input.color(color.new(PURPLE_COLOR, 35), title = "", inline = ema2Inline, group = emaGroup)

string ema3Inline = "EMA 3"
bool ema3Show = input.bool(false, "EMA 3", inline = ema3Inline, group = emaGroup)
string ema3Timeframe = input.timeframe("", title = "", inline = ema3Inline, group = emaGroup)
int ema3Length = input.int(200, minval = 1, title = "", inline = ema3Inline, group = emaGroup)
color ema3Color = input.color(color.new(VIOLET_COLOR, 35), title = "", inline = ema3Inline, group = emaGroup)

//-----------------------------------------------------------------------------
// Calculations
//-----------------------------------------------------------------------------

series float source = close

method getEma(bool showEma, string emaTimeframe, series float sourceInput, int emaLength) =>
    series float emaResult = na
    series float emaValue = ta.ema(sourceInput, emaLength)

    if timeframe.period == "" and showEma
        emaResult := emaValue
    else if timeframe.period != "" and showEma
        emaResult := request.security(syminfo.tickerid, emaTimeframe, emaValue)

    emaResult

series float ema1 = getEma(ema1Show, ema1Timeframe, source, ema1Length)
series float ema2 = getEma(ema2Show, ema2Timeframe, source, ema2Length)
series float ema3 = getEma(ema3Show, ema3Timeframe, source, ema3Length)

//-----------------------------------------------------------------------------
// Render
//-----------------------------------------------------------------------------

plot(ema1, "EMA 1", color = ema1Color, display = display.pane)
plot(ema2, "EMA 2", color = ema2Color, display = display.pane)
plot(ema3, "EMA 3", color = ema3Color, display = display.pane)

//-----------------------------------------------------------------------------
// Round Numbers
//-----------------------------------------------------------------------------

// Settings
//-----------------------------------------------------------------------------

string roundNumberGroup = "Round Numbers"

bool roundNumberShow = input.bool(true, "Show", group = roundNumberGroup)
string roundNumberMode = input.string("Auto", "Mode", options = ["Auto", "Manual"], group = roundNumberGroup)
int roundNumberLines = input.int(20, "Number Of Lines", minval = 4, group = roundNumberGroup)
float manualMajorStep = input.float(10.0, "Major Step", minval = 0.00000001, step = 0.00000001, group = roundNumberGroup)
float manualMinorStep = input.float(5.0, "Minor Step", minval = 0.00000001, step = 0.00000001, group = roundNumberGroup)

//-----------------------------------------------------------------------------
// Calculations
//-----------------------------------------------------------------------------

string symbolName = str.upper(syminfo.tickerid)
string tickerName = str.upper(syminfo.ticker)

bool isForex = syminfo.type == "forex"
bool isJPY = str.contains(symbolName, "JPY")
bool isGold = str.contains(symbolName, "XAU") or str.contains(symbolName, "GOLD")

bool isSpx = str.contains(tickerName, "SPX") or str.contains(tickerName, "SP500") or str.contains(tickerName, "US500") or str.contains(tickerName, "ES1!") or str.contains(tickerName, "SPX500")
bool isNasdaq = str.contains(tickerName, "NAS100") or str.contains(tickerName, "USTEC") or str.contains(tickerName, "NASDAQ") or str.contains(tickerName, "NDX") or str.contains(tickerName, "NQ1!") or str.contains(tickerName, "US100")
bool isDow = str.contains(tickerName, "US30") or str.contains(tickerName, "DJ30") or str.contains(tickerName, "DOW") or str.contains(tickerName, "YM1!") or str.contains(tickerName, "DJI")
bool isGer40 = str.contains(tickerName, "GER40") or str.contains(tickerName, "DE40") or str.contains(tickerName, "DAX") or str.contains(tickerName, "GERMANY40") or str.contains(tickerName, "DEU40")

float autoMajorStep = switch
    isForex and not isJPY => 0.01
    isForex and isJPY => 1
    isGold => 100.0
    isSpx => 100.0
    isNasdaq => 400.0
    isDow => 100.0
    isGer40 => 400.0
    => manualMajorStep

float autoMinorStep = switch
    isForex and not isJPY => 0.005
    isForex and isJPY => 0.5
    isGold => 50.0
    isSpx => 50.0
    isNasdaq => 200.0
    isDow => 50.0
    isGer40 => 200.0
    => manualMinorStep

float majorStep = roundNumberMode == "Auto" ? autoMajorStep : manualMajorStep
float minorStep = roundNumberMode == "Auto" ? autoMinorStep : manualMinorStep

//-----------------------------------------------------------------------------
// Line Management
//-----------------------------------------------------------------------------

var line[] roundNumberLineArray = array.new_line()

if barstate.islast
    if array.size(roundNumberLineArray) > 0
        for lineIndex = 0 to array.size(roundNumberLineArray) - 1
            line.delete(array.get(roundNumberLineArray, lineIndex))

        array.clear(roundNumberLineArray)

    if roundNumberShow
        //------------------------------------------------------------------------
        // Major Round Numbers
        //------------------------------------------------------------------------

        int majorLineCount = roundNumberLines / 4
        float majorBasePrice = math.floor(close / majorStep) * majorStep

        for lineIndex = 0 to majorLineCount - 1
            float upperMajorLevel = majorBasePrice + ((lineIndex + 1) * majorStep)
            float lowerMajorLevel = majorBasePrice - (lineIndex * majorStep)

            line upperMajorLine = line.new(
                bar_index,
                upperMajorLevel,
                bar_index - 1,
                upperMajorLevel,
                xloc = xloc.bar_index,
                extend = extend.both,
                color = LIGHT_GRAY_COLOR,
                width = 1,
                style = line.style_dotted
            )

            line lowerMajorLine = line.new(
                bar_index,
                lowerMajorLevel,
                bar_index - 1,
                lowerMajorLevel,
                xloc = xloc.bar_index,
                extend = extend.both,
                color = LIGHT_GRAY_COLOR,
                width = 1,
                style = line.style_dotted
            )

            array.push(roundNumberLineArray, upperMajorLine)
            array.push(roundNumberLineArray, lowerMajorLine)

        //------------------------------------------------------------------------
        // Minor Round Numbers
        //------------------------------------------------------------------------

        int minorLineCount = roundNumberLines / 2
        float minorBasePrice = math.floor(close / minorStep) * minorStep

        for lineIndex = 0 to minorLineCount - 1
            float upperMinorLevel = minorBasePrice + ((lineIndex + 1) * minorStep)
            float lowerMinorLevel = minorBasePrice - (lineIndex * minorStep)

            line upperMinorLine = line.new(
                bar_index,
                upperMinorLevel,
                bar_index - 1,
                upperMinorLevel,
                xloc = xloc.bar_index,
                extend = extend.both,
                color = DARK_GRAY_COLOR,
                width = 1,
                style = line.style_dotted
            )

            line lowerMinorLine = line.new(
                bar_index,
                lowerMinorLevel,
                bar_index - 1,
                lowerMinorLevel,
                xloc = xloc.bar_index,
                extend = extend.both,
                color = DARK_GRAY_COLOR,
                width = 1,
                style = line.style_dotted
            )

            array.push(roundNumberLineArray, upperMinorLine)
            array.push(roundNumberLineArray, lowerMinorLine)